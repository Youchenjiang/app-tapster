<Window x:Class="Tapster.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tapster"
        Width="540" Height="700"
        MinWidth="480" MinHeight="640"
        WindowStartupLocation="Manual"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource SolidBaseBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource SolidBaseBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="⌨" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Tapster" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="TopmostCheck" Content="Always on top" 
                              IsChecked="True"
                              Margin="0,0,8,0"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"
                              Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                    <Button x:Name="MinimizeBtn" Content="─" Width="46" Height="32"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="12" BorderThickness="0" Cursor="Hand"
                            Click="MinimizeBtn_Click"/>
                    <Button x:Name="CloseBtn" Content="✕" Width="46" Height="32"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="12" BorderThickness="0" Cursor="Hand"
                            Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="16,8,16,8">
                <!-- Tab 1: Auto Typer -->
                <TabItem Header="Auto Typer">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Text to type into VNC:" 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   Margin="4,0,4,8"/>

                        <Border Grid.Row="1" 
                                CornerRadius="8" Padding="1">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ControlFillColor}" Opacity="0.06"/>
                            </Border.Background>
                            <TextBox x:Name="TypeTextBox"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="Cascadia Code, Consolas" FontSize="12"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Padding="12,10"
                                     BorderThickness="0"/>
                        </Border>

                        <Grid Grid.Row="2" Margin="4,8,4,4">
                            <DockPanel>
                                <Button Content="Paste" DockPanel.Dock="Right"
                                        Style="{StaticResource GhostButton}"
                                        Click="Paste_Click"/>
                                <Button Content="Clear" DockPanel.Dock="Right"
                                        Style="{StaticResource GhostButton}"
                                        Margin="0,0,4,0"
                                        Click="ClearText_Click"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Interval (s/char):" 
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TypeIntervalBox" Width="60"
                                             Style="{StaticResource FluentTextBox}"
                                             Text="0.03" FontSize="12" Padding="8,4"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="4,4,4,2">
                            <DockPanel>
                                <TextBlock Text="History" Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="12" VerticalAlignment="Center"/>
                                <Button Content="Clear" DockPanel.Dock="Right"
                                        Style="{StaticResource GhostButton}"
                                        FontSize="11"
                                        Click="ClearHistory_Click"/>
                            </DockPanel>
                        </Grid>

                        <Border Grid.Row="4" Background="{StaticResource ControlFillBrush}" 
                                CornerRadius="8" Padding="4">
                            <ListBox x:Name="HistoryList"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="Cascadia Code, Consolas" FontSize="11"
                                     MaxHeight="80"
                                     BorderThickness="0"
                                     SelectionChanged="HistoryList_SelectionChanged"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Key Holder -->
                <TabItem Header="Key Holder">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                        <StackPanel Margin="4">
                            <!-- Combo Display Card -->
                            <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                                <DockPanel>
                                    <Button Content="Clear" DockPanel.Dock="Right"
                                            Style="{StaticResource GhostButton}"
                                            FontSize="11" Margin="8,0,0,0"
                                            Click="ClearCombo_Click"/>
                                    <Button x:Name="CaptureBtn" Content="⏺ Capture Keys" 
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource GhostButton}"
                                            FontSize="11"
                                            Click="ToggleCapture_Click"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Selected: " 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ComboDisplay" Text="(none)"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontFamily="Cascadia Code, Consolas" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Virtual Keyboard Card -->
                            <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                                <StackPanel x:Name="KeyboardPanel"/>
                            </Border>

                            <!-- Hold Mode Card -->
                            <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Hold Mode" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeIndefinite" Content="Until Esc" 
                                                     IsChecked="True" GroupName="HoldMode"
                                                     Margin="0,0,16,0"
                                                     Checked="HoldMode_Changed"/>
                                        <RadioButton x:Name="ModeTimed" Content="Timed" 
                                                     GroupName="HoldMode"
                                                     Margin="0,0,16,0"
                                                     Checked="HoldMode_Changed"/>
                                        <RadioButton x:Name="ModeRotation" Content="Rotation" 
                                                     GroupName="HoldMode"
                                                     Checked="HoldMode_Changed"/>
                                    </StackPanel>

                                    <!-- Timed Duration -->
                                    <StackPanel x:Name="TimedPanel" Visibility="Collapsed"
                                                Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="Duration (s):" Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="DurationBox" Width="70"
                                                 Style="{StaticResource FluentTextBox}"
                                                 Text="10.0" FontSize="12" Padding="8,4"/>
                                    </StackPanel>

                                    <!-- Rotation Panel -->
                                    <StackPanel x:Name="RotationPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                        <TextBlock Text="Steps" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <Border Background="{StaticResource ControlFillBrush}" 
                                                CornerRadius="8" Padding="8">
                                            <ListBox x:Name="RotationList"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     FontFamily="Cascadia Code, Consolas" FontSize="11"
                                                     MaxHeight="100"
                                                     BorderThickness="0"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Hold" Foreground="{StaticResource TextSecondaryBrush}" 
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RotationStepCombo" Text="(select keys)"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"
                                                       Width="100" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                            <TextBlock Text="for" Foreground="{StaticResource TextSecondaryBrush}" 
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="RotationDurBox" Width="50"
                                                     Style="{StaticResource FluentTextBox}"
                                                     Text="1.0" FontSize="11" Padding="6,4" Margin="8,0,4,0"/>
                                            <TextBlock Text="s" Foreground="{StaticResource TextSecondaryBrush}" 
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <Button Content="+" Style="{StaticResource FluentButton}"
                                                    FontSize="12" Padding="12,4" Margin="12,0,4,0"
                                                    Click="AddRotationStep_Click"/>
                                            <Button Content="−" Style="{StaticResource GhostButton}"
                                                    FontSize="12" Padding="12,4"
                                                    Click="RemoveRotationStep_Click"/>
                                        </StackPanel>
                                        <CheckBox x:Name="RotationLoopCheck" Content="Loop" IsChecked="True"
                                                  Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                  Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: Auto Clicker -->
                <TabItem Header="Auto Clicker">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                        <StackPanel Margin="4">
                            <!-- Mode Card -->
                            <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Mode" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeSimple" Content="Simple Click" 
                                                     IsChecked="True" GroupName="ClickMode"
                                                     Margin="0,0,16,0"
                                                     Checked="ClickMode_Changed"/>
                                        <RadioButton x:Name="ModeRecord" Content="Record &amp; Replay" 
                                                     GroupName="ClickMode"
                                                     Checked="ClickMode_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Simple Click Card -->
                            <Border x:Name="SimpleClickCard" Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Mouse Button -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Button" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton x:Name="BtnLeft" Content="Left" IsChecked="True" 
                                                         GroupName="MouseButton" Margin="0,0,16,0"/>
                                            <RadioButton x:Name="BtnRight" Content="Right" 
                                                         GroupName="MouseButton" Margin="0,0,16,0"/>
                                            <RadioButton x:Name="BtnMiddle" Content="Middle" 
                                                         GroupName="MouseButton"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Interval -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Interval (ms)" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="ClickIntervalBox" Width="80" HorizontalAlignment="Left"
                                                 Style="{StaticResource FluentTextBox}"
                                                 Text="100" FontSize="12" Padding="8,4"/>
                                    </Grid>

                                    <!-- Count -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Count" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton x:Name="CountUnlimited" Content="Unlimited" 
                                                         IsChecked="True" GroupName="ClickCount"
                                                         Margin="0,0,16,0"
                                                         Checked="ClickCount_Changed"/>
                                            <RadioButton x:Name="CountLimited" Content="Limit:" 
                                                         GroupName="ClickCount"
                                                         VerticalAlignment="Center"
                                                         Checked="ClickCount_Changed"/>
                                            <TextBox x:Name="ClickCountBox" Width="80"
                                                     Style="{StaticResource FluentTextBox}"
                                                     Text="100" FontSize="12" Padding="8,4"
                                                     IsEnabled="False" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hold Key -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Hold key" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="HoldKeyBox" Width="120"
                                                     Style="{StaticResource FluentTextBox}"
                                                     FontSize="12" Padding="8,4"/>
                                            <TextBlock Text="ctrl, alt, ctrl+shift" 
                                                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Record Card -->
                            <Border x:Name="RecordCard" Style="{StaticResource FluentCard}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Recorded actions" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RecordStatus" Text="No actions recorded"
                                                   Grid.Column="1"
                                                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button x:Name="RecordBtn" Content="⏺  Start Recording"
                                                Style="{StaticResource FluentButton}"
                                                FontSize="12" Padding="16,8"
                                                Click="ToggleRecord_Click"/>
                                        <Button Content="Clear" Style="{StaticResource GhostButton}"
                                                FontSize="12" Margin="8,0,0,0"
                                                Click="ClearRecord_Click"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Speed" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Slider x:Name="ReplaySpeedSlider" Width="160"
                                                    Minimum="0.1" Maximum="5.0" Value="1.0"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="x" Foreground="{StaticResource TextSecondaryBrush}" 
                                                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Loop" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton x:Name="LoopOnce" Content="Once" IsChecked="True"
                                                         GroupName="ReplayLoop" Margin="0,0,16,0"/>
                                            <RadioButton x:Name="LoopRepeat" Content="Repeat:"
                                                         GroupName="ReplayLoop"
                                                         VerticalAlignment="Center"/>
                                            <TextBox x:Name="ReplayCountBox" Width="60"
                                                     Style="{StaticResource FluentTextBox}"
                                                     Text="10" FontSize="12" Padding="8,4" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource SolidBaseBrush}" 
                    Padding="16,0,16,16">
                <StackPanel>
                    <!-- Delay -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Delay (s):" 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="DelayBox" Width="40"
                                 Style="{StaticResource FluentTextBox}"
                                 Text="3" FontSize="12" Padding="8,4" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock x:Name="StatusText" Text="Ready"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               Margin="0,0,0,8"/>

                    <!-- Progress -->
                    <ProgressBar x:Name="ProgressBar" Margin="0,0,0,12"/>

                    <!-- Action Button -->
                    <Button x:Name="ActionBtn" Content="Start"
                            Style="{StaticResource FluentButton}"
                            FontSize="13" Padding="24,12"
                            Click="ActionBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
