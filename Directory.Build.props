<Project>
  <PropertyGroup>
    <!-- Centralized version management -->
    <Version>1.3.0.0</Version>
    <Company>Youchen Jiang</Company>
    <!-- Disable MSBuild node reuse and shared compilation background daemons -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <NodeReuse>false</NodeReuse>
  </PropertyGroup>
</Project>
