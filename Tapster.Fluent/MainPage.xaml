<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tapster_Fluent.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Tapster_Fluent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView x:Name="NavView"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        OpenPaneLength="180"
                        CompactPaneLength="48"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Auto Typer" Tag="Typer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Key Holder" Tag="Holder">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Auto Clicker" Tag="Clicker">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE962;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Macro Recorder" Tag="Macro">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20,12,20,16">
                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 1. Auto Typer Panel                                        -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="TyperPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10" Spacing="2">
                        <TextBlock Text="Auto Typer" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Simulates keyboard input for VNC, VM consoles, or automated text entry."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>

                    <!-- Main Text Box Card -->
                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Target Text:" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Click="Paste_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Paste from Clipboard">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE77F;" FontSize="12"/>
                                            <TextBlock Text="Paste"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ClearText_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Clear All Text">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE894;" FontSize="12"/>
                                            <TextBlock Text="Clear"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBox x:Name="TypeTextBox" Grid.Row="1"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Cascadia Code, Consolas" FontSize="13"
                                     Padding="12" PlaceholderText="Enter text to automatically type..."/>
                        </Grid>
                    </Border>

                    <!-- Interval Setting Card -->
                    <Border Grid.Row="2" Margin="0,8,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Keystroke Interval (sec/char):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                            <NumberBox x:Name="TypeIntervalBox" Width="100" Value="0.03" Minimum="0.001" Maximum="5" SmallChange="0.01"
                                       FontSize="12" SpinButtonPlacementMode="Compact"/>
                        </StackPanel>
                    </Border>

                    <!-- History Card -->
                    <Border Grid.Row="3" Margin="0,8,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Execution History" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="HistoryList" MaxHeight="50"
                                      FontFamily="Cascadia Code, Consolas" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Dedicated Action Card for Typer -->
                    <Border Grid.Row="4" Margin="0,10,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Delay (s):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="TyperDelayBox" Width="68" Value="3" Minimum="0" Maximum="60"
                                           FontSize="12" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="TyperStatusText" Text="Ready" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="TyperProgressBar" Height="3" Value="0" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Button x:Name="TyperActionBtn" Grid.Column="2" Width="120" Height="34" Click="TyperActionBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:Name="TyperActionIcon" Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock x:Name="TyperActionText" Text="Start Typer" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 2. Key Holder Panel                                        -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="HolderPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Key Holder" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Holds down specified key or key combination continuously."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="Target Key / Combo:" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button x:Name="CaptureKeyBtn" Click="CaptureKeyBtn_Click" Style="{StaticResource SubtleButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon x:Name="CaptureIcon" Glyph="&#xE7C8;" FontSize="12"/>
                                                    <TextBlock x:Name="CaptureKeyText" Text="Capture Key"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="ClearHolderKey_Click" Style="{StaticResource SubtleButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE894;" FontSize="12"/>
                                                    <TextBlock Text="Clear"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox x:Name="HolderKeyBox" Text="w" PlaceholderText="Target key combo (e.g. w, ctrl+shift+a)..."
                                             FontFamily="Cascadia Code, Consolas" FontSize="14" Padding="10,6"/>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Hold Duration (seconds, 0 = infinite):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                        <NumberBox x:Name="HoldDurationBox" Width="100" Value="10" Minimum="0"
                                                   FontSize="12" SpinButtonPlacementMode="Compact"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- On-Screen Realistic Visual Virtual Keyboard -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Visual Virtual Keyboard (Click keys to build combo)" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="KeyboardContainer" Spacing="4" HorizontalAlignment="Left">
                                            <!-- Structured Keyboard Rows generated in MainPage.xaml.cs -->
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dedicated Action Card for Key Holder -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Delay (s):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="HolderDelayBox" Width="68" Value="3" Minimum="0" Maximum="60"
                                           FontSize="12" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="HolderStatusText" Text="Ready" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="HolderProgressBar" Height="3" Value="0" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Button x:Name="HolderActionBtn" Grid.Column="2" Width="120" Height="34" Click="HolderActionBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:Name="HolderActionIcon" Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock x:Name="HolderActionText" Text="Start Holder" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 3. Auto Clicker Panel                                      -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="ClickerPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Auto Clicker" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Automates mouse clicks with precise interval and coordinate targeting."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14">
                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mouse Button:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <ComboBox x:Name="MouseButtonCombo" Grid.Row="0" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Left" Width="160">
                                    <ComboBoxItem Content="Left Click"/>
                                    <ComboBoxItem Content="Right Click"/>
                                    <ComboBoxItem Content="Middle Click"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Click Interval (sec):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="ClickIntervalBox" Grid.Row="1" Grid.Column="1" Value="0.1" Minimum="0.005" SmallChange="0.05"
                                           FontSize="12" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" Width="160"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Repeat Count (0 = Infinite):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="ClickCountBox" Grid.Row="2" Grid.Column="1" Value="100" Minimum="0"
                                           FontSize="12" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" Width="160"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Target Coordinates:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="X:" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <NumberBox x:Name="ClickXBox" Width="70" PlaceholderText="Current" FontSize="12" SpinButtonPlacementMode="Compact"/>
                                    <TextBlock Text="Y:" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <NumberBox x:Name="ClickYBox" Width="70" PlaceholderText="Current" FontSize="12" SpinButtonPlacementMode="Compact"/>
                                    <Button x:Name="PickCoordBtn" Click="PickCoordBtn_Click" Style="{StaticResource SubtleButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE707;" FontSize="12"/>
                                            <TextBlock Text="Pick Location"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Dedicated Action Card for Clicker -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Delay (s):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="ClickerDelayBox" Width="68" Value="3" Minimum="0" Maximum="60"
                                           FontSize="12" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="ClickerStatusText" Text="Ready" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="ClickerProgressBar" Height="3" Value="0" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Button x:Name="ClickerActionBtn" Grid.Column="2" Width="120" Height="34" Click="ClickerActionBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:Name="ClickerActionIcon" Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock x:Name="ClickerActionText" Text="Start Clicker" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 4. Macro Recorder Panel                                    -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="MacroPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Macro Recorder" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Record user mouse clicks and keystrokes and replay them back."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="RecordMacroBtn" Click="RecordMacroBtn_Click" Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="RecordIcon" Glyph="&#xE7C8;" FontSize="12"/>
                                            <TextBlock x:Name="RecordMacroText" Text="Start Recording"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ClearMacroBtn_Click" Style="{StaticResource SubtleButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE894;" FontSize="12"/>
                                            <TextBlock Text="Clear Macro"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Grid RowSpacing="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Replay Loop Count (0 = Infinite):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <NumberBox x:Name="MacroRepeatBox" Grid.Row="0" Grid.Column="1" Value="1" Minimum="0" Width="100" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Replay Speed Multiplier:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <NumberBox x:Name="MacroSpeedBox" Grid.Row="1" Grid.Column="1" Value="1.0" Minimum="0.1" Maximum="10.0" SmallChange="0.5" Width="100" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact"/>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Recorded Actions:" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ListView x:Name="MacroActionList" MaxHeight="140"
                                              FontFamily="Cascadia Code, Consolas" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Dedicated Action Card for Macro Replay -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Delay (s):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="MacroDelayBox" Width="68" Value="3" Minimum="0" Maximum="60"
                                           FontSize="12" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="MacroStatusText" Text="Ready" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="MacroProgressBar" Height="3" Value="0" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Button x:Name="MacroActionBtn" Grid.Column="2" Width="120" Height="34" Click="MacroActionBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:Name="MacroActionIcon" Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock x:Name="MacroActionText" Text="Replay Macro" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 5. Settings Panel                                          -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                        <TextBlock Text="偏好設定 (Settings)" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="自訂 Tapster 系統常駐、開機自動啟動與視窗行為" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="12" Margin="0,0,8,0">
                            <!-- Card 1: Start on Boot -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="開機自動啟動 (Start with Windows)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="於 Windows 登入時自動在背景啟動 Tapster 並常駐於系統匣"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartOnBootToggle" Grid.Column="1"
                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                  Toggled="StartOnBootToggle_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: Start Minimized to Tray -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="啟動時縮小至系統匣 (Start Minimized to Tray)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="開啟應用程式時直接隱藏至右下角系統匣，不彈出主視窗干擾"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="1"
                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                  Toggled="StartMinimizedToggle_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Card 3: Minimize on Close -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="點擊關閉 (X) 時縮小至系統匣 (Minimize on Close)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="點擊右上角關閉按鈕時縮排至系統匣，保持全域快捷鍵隨叫隨到"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MinimizeOnCloseToggle" Grid.Column="1"
                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                  Toggled="MinimizeOnCloseToggle_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Card 4: Global Hotkey Info -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="全域喚醒熱鍵 (Global Wake Hotkey)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="隨時在任何視窗按下熱鍵即可喚醒或隱藏 Tapster"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl + Alt + T" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 5: Navigation to About -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="版本與專案資訊 (About &amp; Version)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Tapster Fluent v1.1.0 (WinUI 3 + .NET NativeAOT Architecture)"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="查看詳情" FontSize="11"
                                            Click="NavigateToAbout_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 6. About Panel                                             -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="AboutPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                        <TextBlock Text="關於 Tapster (About)" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="應用程式版本、技術規格、專案連結與隱私聲明" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="16" Margin="0,0,8,0">
                            <!-- Hero Card -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="Assets/StoreLogo.png" Width="64" Height="64"
                                           Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="Tapster Fluent" FontSize="20" FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="8,2">
                                                <TextBlock Text="v1.1.0 Release" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Windows 11 原生超輕量自動化助手 (Native Automation Utility)"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="專為遠端桌面 (VNC/RDP)、虛擬機、遊戲掛機與高頻點擊量身打造"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tech Specs Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="技術規格 (Technical Specifications)" FontWeight="SemiBold" FontSize="13"/>
                                    <Grid RowSpacing="8" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="UI 框架" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="WinUI 3 (Windows App SDK 2.3.1) Mica &amp; Acrylic" FontSize="11"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="底層自動化核心" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="C# .NET 8 + Win32 Native P/Invoke (&lt; 35MB RAM, &lt; 1ms Latency)" FontSize="11"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="發布架構" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="雙軌制：Microsoft Store MSIX 封裝 + Standalone 綠色純單檔 EXE" FontSize="11"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="授權條款" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT License (開源且自由使用)" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Privacy and Open Folder Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="隱私承諾與本地設定 (Privacy &amp; Data)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="100% 離線純本機運行，零網路遙測傳輸，不收集任何按鍵或個人資料"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="開啟設定目錄" FontSize="11"
                                            Click="OpenSettingsFolder_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
