<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tapster_Fluent.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Tapster_Fluent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView x:Name="NavView"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="True"
                        AlwaysShowHeader="False"
                        Header="{x:Null}"
                        OpenPaneLength="180"
                        CompactPaneLength="48"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemTyper" Content="打字" Tag="Typer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemHolder" Content="長按" Tag="Holder">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemClicker" Content="連點" Tag="Clicker">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE962;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemMacro" Content="重放" Tag="Macro">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemAbout" Content="關於" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20,12,20,16">
                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 1. Auto Typer Panel                                        -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="TyperPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="10" Margin="0,0,8,0">
                            <!-- Header -->
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TyperHeaderTitle" Text="Auto Typer" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TyperHeaderDesc" Text="Simulates keyboard input for VNC, VM consoles, or automated text entry."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>

                            <!-- Main Text Box Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock x:Name="TyperTargetTextLabel" Text="Target Text:" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button Click="Paste_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Paste from Clipboard">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE77F;" FontSize="12"/>
                                                    <TextBlock x:Name="PasteTextBtnLabel" Text="Paste"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ClearTextBtn" Click="ClearText_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Clear All Text" IsEnabled="False">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE894;" FontSize="12"/>
                                                    <TextBlock x:Name="ClearTextBtnLabel" Text="Clear"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox x:Name="TypeTextBox" Grid.Row="1"
                                             MinHeight="140"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             FontFamily="Cascadia Code, Consolas" FontSize="13"
                                             Padding="12" PlaceholderText="Enter text to automatically type..."/>
                                </Grid>
                            </Border>

                            <!-- Mode & Options Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10">
                                <Grid RowSpacing="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Input Mode: Keystroke vs Clipboard Paste -->
                                    <TextBlock x:Name="TyperModeLabel" Grid.Row="0" Grid.Column="0" Text="Typing Mode:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ComboBox x:Name="TypeModeCombo" SelectedIndex="0" Width="200" HorizontalAlignment="Left">
                                            <ComboBoxItem x:Name="TypeModeKeystrokeItem" Content="⌨️ Keystroke Emulation"/>
                                            <ComboBoxItem x:Name="TypeModeClipboardItem" Content="📋 Clipboard Paste (Instant)"/>
                                        </ComboBox>
                                        <TextBlock x:Name="TypeModeHint" Text="⚡ Instant paste (Ctrl+V) with clipboard auto-restore"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- Trailing Key: None / Enter / Tab -->
                                    <TextBlock x:Name="TyperTrailingKeyLabel" Grid.Row="1" Grid.Column="0" Text="Trailing Key:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <ComboBox x:Name="TypeTrailingKeyCombo" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem x:Name="TypeTrailingNoneItem" Content="None"/>
                                        <ComboBoxItem x:Name="TypeTrailingEnterItem" Content="Enter (Send / Newline)"/>
                                        <ComboBoxItem x:Name="TypeTrailingTabItem" Content="Tab (Switch Field)"/>
                                    </ComboBox>

                                    <!-- Keystroke Interval & Jitter (Keystroke only) -->
                                    <TextBlock x:Name="TypeIntervalLabel" Grid.Row="2" Grid.Column="0" Text="Interval (sec/char):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <StackPanel x:Name="TypeIntervalPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <NumberBox x:Name="TypeIntervalBox" Width="80" Value="0.03" Minimum="0.001" Maximum="5" SmallChange="0.01"
                                                   FontSize="12" SpinButtonPlacementMode="Compact"/>
                                        <CheckBox x:Name="TypeJitterCheck" Content="Natural Typing Jitter (±15%)" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- History Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,6">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="TyperHistoryHeader" Text="Execution History" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ListView x:Name="HistoryList" MaxHeight="50"
                                              FontFamily="Cascadia Code, Consolas" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dedicated Action Card for Typer -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TyperDelayLabel" Text="Delay (s):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="TyperDelayBox" Width="68" Value="3" Minimum="0" Maximum="60"
                                           FontSize="12" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="TyperStatusText" Text="Ready" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="TyperProgressBar" Height="3" Value="0" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Button x:Name="TyperActionBtn" Grid.Column="2" Width="136" Height="34" Click="TyperActionBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:Name="TyperActionIcon" Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock x:Name="TyperActionText" Text="Start Typer (F8)" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 2. Key Holder Panel                                        -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="HolderPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="HolderScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="10" Padding="0,0,0,16">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="HolderHeaderTitle" Text="Key Holder" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HolderHeaderDesc" Text="Holds down specified key or key combination continuously."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>

                            <!-- Step Timeline Pipeline Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <StackPanel Spacing="10">
                                    <!-- Pipeline Header -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <TextBlock x:Name="HolderPipelineTitle" Text="Key Pipeline Sequence" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="HolderPipelineHint" Text="• Click any step to edit its combo using the keyboard below"
                                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel x:Name="HolderRepeatPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="HolderRepeatLabel" Text="Repeat Loops:" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <NumberBox x:Name="HolderRepeatBox" Width="72" Value="1" Minimum="0" SmallChange="1"
                                                       FontSize="12" SpinButtonPlacementMode="Compact"
                                                       ToolTipService.ToolTip="Number of sequence loops (0 = Infinite)"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Interactive Step Cards Container -->
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="HolderStepsContainer" Spacing="6"/>
                                    </ScrollViewer>

                                    <!-- Add Step Button -->
                                    <Button x:Name="AddStepBtn" Click="AddStepBtn_Click" HorizontalAlignment="Stretch"
                                            Style="{StaticResource SubtleButtonStyle}" CornerRadius="6" Padding="10,6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <TextBlock x:Name="AddStepBtnText" Text="Add Step to Sequence" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Visual Virtual Keyboard Controller Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="HolderVkTitle" Text="Virtual Keyboard Controller" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ActiveStepTargetHint" Text="(Editing Step #1)" FontSize="11"
                                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button x:Name="CaptureKeyBtn" Click="CaptureKeyBtn_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon x:Name="CaptureIcon" Glyph="&#xE7C8;" FontSize="11"/>
                                                    <TextBlock x:Name="CaptureKeyText" Text="Capture Physical Key" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ClearActiveStepKeysBtn" Click="ClearActiveStepKeysBtn_Click" Style="{StaticResource SubtleButtonStyle}" Padding="8,4">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE894;" FontSize="11"/>
                                                    <TextBlock x:Name="ClearActiveStepKeysBtnText" Text="Clear Keys" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="KeyboardContainer" Spacing="4" HorizontalAlignment="Center">
                                        <!-- Structured Keyboard Rows generated in MainPage.xaml.cs -->
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dedicated Action Card for Key Holder -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="HolderDelayLabel" Text="Delay (s):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="HolderDelayBox" Width="68" Value="3" Minimum="0" Maximum="60"
                                           FontSize="12" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="HolderStatusText" Text="Ready" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="HolderProgressBar" Height="3" Value="0" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Button x:Name="HolderActionBtn" Grid.Column="2" Width="136" Height="34" Click="HolderActionBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:Name="HolderActionIcon" Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock x:Name="HolderActionText" Text="Start Holder (F7)" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 3. Auto Clicker Panel                                      -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="ClickerPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="12" Margin="0,0,8,0">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="ClickerHeaderTitle" Text="Auto Clicker" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ClickerHeaderDesc" Text="Automates mouse clicks with precise interval and coordinate targeting."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <Grid RowSpacing="12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Target Type: Mouse or Keyboard Spammer -->
                                    <TextBlock x:Name="ClickerTargetTypeLabel" Grid.Row="0" Grid.Column="0" Text="Target Type:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <ComboBox x:Name="ClickTargetTypeCombo" Grid.Row="0" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Left" Width="200">
                                        <ComboBoxItem x:Name="ClickTargetMouseItem" Content="🖱️ Mouse Click"/>
                                        <ComboBoxItem x:Name="ClickTargetKeyboardItem" Content="⌨️ Keyboard Spammer"/>
                                    </ComboBox>

                                    <!-- Trigger Mode: Toggle or Hold-to-Click -->
                                    <TextBlock x:Name="ClickerTriggerModeLabel" Grid.Row="1" Grid.Column="0" Text="Trigger Mode:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ComboBox x:Name="ClickTriggerModeCombo" SelectedIndex="0" HorizontalAlignment="Left" Width="200">
                                            <ComboBoxItem x:Name="ClickTriggerToggleItem" Content="Toggle (Press to Start/Stop)"/>
                                            <ComboBoxItem x:Name="ClickTriggerHoldItem" Content="Hold to Click (Hold F6)"/>
                                        </ComboBox>
                                        <TextBlock x:Name="HoldModeHint" Text="💡 Hold hotkey to spam, release to stop"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- Mouse Button (Shown for Mouse Click) -->
                                    <TextBlock x:Name="MouseButtonLabel" Grid.Row="2" Grid.Column="0" Text="Mouse Button:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <ComboBox x:Name="MouseButtonCombo" Grid.Row="2" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Left" Width="200">
                                        <ComboBoxItem x:Name="MouseLeftItem" Content="Left Click"/>
                                        <ComboBoxItem x:Name="MouseRightItem" Content="Right Click"/>
                                        <ComboBoxItem x:Name="MouseMiddleItem" Content="Middle Click"/>
                                    </ComboBox>

                                    <!-- Keyboard Key (Shown for Keyboard Spammer) -->
                                    <TextBlock x:Name="SpamKeyLabel" Grid.Row="2" Grid.Column="0" Text="Spam Key / Combo:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Visibility="Collapsed"/>
                                    <TextBox x:Name="SpamKeyBox" Grid.Row="2" Grid.Column="1" Text="space" PlaceholderText="Key to spam (e.g. space, f, 1, e)"
                                             FontFamily="Cascadia Code, Consolas" FontSize="12" Width="200" HorizontalAlignment="Left" Visibility="Collapsed"/>

                                    <!-- Click / Spam Interval -->
                                    <TextBlock x:Name="ClickerIntervalLabel" Grid.Row="3" Grid.Column="0" Text="Interval (sec):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <NumberBox x:Name="ClickIntervalBox" Grid.Row="3" Grid.Column="1" Value="0.1" Minimum="0.005" SmallChange="0.05"
                                               FontSize="12" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" Width="200"/>

                                    <!-- Repeat Count -->
                                    <TextBlock x:Name="ClickerCountLabel" Grid.Row="4" Grid.Column="0" Text="Repeat Count (0 = Infinite):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <NumberBox x:Name="ClickCountBox" Grid.Row="4" Grid.Column="1" Value="100" Minimum="0"
                                               FontSize="12" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" Width="200"/>

                                    <!-- Target Coordinates (Mouse only) -->
                                    <TextBlock x:Name="ClickCoordsLabel" Grid.Row="5" Grid.Column="0" Text="Target Coordinates:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <StackPanel x:Name="ClickCoordsPanel" Grid.Row="5" Grid.Column="1" Orientation="Vertical" Spacing="6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="X:" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <NumberBox x:Name="ClickXBox" Width="70" PlaceholderText="Current" FontSize="12" SpinButtonPlacementMode="Compact"/>
                                            <TextBlock Text="Y:" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <NumberBox x:Name="ClickYBox" Width="70" PlaceholderText="Current" FontSize="12" SpinButtonPlacementMode="Compact"/>
                                            <Button x:Name="PickCoordBtn" Click="PickCoordBtn_Click" Style="{StaticResource SubtleButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon x:Name="PickCoordIcon" Glyph="&#xE707;" FontSize="12"/>
                                                    <TextBlock x:Name="PickCoordText" Text="Pick Location"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ClearCoordsBtn" Click="ClearCoordsBtn_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Clear coordinates to click at current cursor position" IsEnabled="False">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE894;" FontSize="12"/>
                                                    <TextBlock x:Name="ClearCoordsBtnText" Text="Clear"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowTargetMarkerCheck" Content="Show Target Marker on Screen" FontSize="12" Margin="0,-2,0,0"/>
                                    </StackPanel>

                                    <!-- Time Jitter (Random Interval) -->
                                    <TextBlock x:Name="TimeJitterLabel" Grid.Row="6" Grid.Column="0" Text="Time Jitter (±%):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <CheckBox x:Name="TimeJitterCheck" Content="Randomize interval" FontSize="12" VerticalAlignment="Center"/>
                                        <NumberBox x:Name="TimeJitterBox" Width="80" Value="15" Minimum="1" Maximum="100"
                                                   FontSize="12" SpinButtonPlacementMode="Compact" IsEnabled="False"/>
                                        <TextBlock Text="%" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Location Jitter (Spatial Randomness) -->
                                    <TextBlock x:Name="LocationJitterLabel" Grid.Row="7" Grid.Column="0" Text="Location Jitter (±px):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                    <StackPanel x:Name="LocationJitterPanel" Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <NumberBox x:Name="LocationJitterBox" Width="80" Value="0" Minimum="0" Maximum="100"
                                                   FontSize="12" SpinButtonPlacementMode="Compact"/>
                                        <TextBlock x:Name="LocationJitterHintText" Text="px radius (0 = exact point)" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dedicated Action Card for Clicker -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ClickerDelayLabel" Text="Delay (s):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="ClickerDelayBox" Width="68" Value="3" Minimum="0" Maximum="60"
                                           FontSize="12" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="ClickerStatusText" Text="Ready" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="ClickerProgressBar" Height="3" Value="0" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Button x:Name="ClickerActionBtn" Grid.Column="2" Width="136" Height="34" Click="ClickerActionBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:Name="ClickerActionIcon" Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock x:Name="ClickerActionText" Text="Start Clicker (F6)" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 4. Macro Recorder Panel                                    -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="MacroPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="12" Margin="0,0,8,0">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="MacroHeaderTitle" Text="Macro Recorder" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MacroHeaderDesc" Text="Record user mouse clicks and keystrokes and replay them back."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="RecordMacroBtn" Click="RecordMacroBtn_Click" Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon x:Name="RecordIcon" Glyph="&#xE7C8;" FontSize="12"/>
                                                <TextBlock x:Name="RecordMacroText" Text="Start Recording"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ClearMacroBtn" Click="ClearMacroBtn_Click" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE894;" FontSize="12"/>
                                                <TextBlock x:Name="ClearMacroBtnText" Text="Clear Macro"/>
                                            </StackPanel>
                                        </Button>
                                        
                                    </StackPanel>

                                    <Grid RowSpacing="8" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="MacroRepeatLabel" Grid.Row="0" Grid.Column="0" Text="Replay Loop Count (0 = Infinite):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                        <NumberBox x:Name="MacroRepeatBox" Grid.Row="0" Grid.Column="1" Value="1" Minimum="0" Width="100" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact"/>

                                        <TextBlock x:Name="MacroSpeedLabel" Grid.Row="1" Grid.Column="0" Text="Replay Speed Multiplier:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                        <NumberBox x:Name="MacroSpeedBox" Grid.Row="1" Grid.Column="1" Value="1.0" Minimum="0.1" Maximum="10.0" SmallChange="0.5" Width="100" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact"/>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="MacroActionsHeader" Grid.Column="0" Text="Recorded Actions (Double-click step to edit):" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button x:Name="EditActionBtn" Click="EditActionBtn_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6,3" IsEnabled="False">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="11"/>
                                                        <TextBlock x:Name="EditActionBtnText" Text="Edit Step" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="DeleteActionBtn" Click="DeleteActionBtn_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6,3" IsEnabled="False">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                                        <TextBlock x:Name="DeleteActionBtnText" Text="Delete Step" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ListView x:Name="MacroActionList" MaxHeight="140"
                                                  FontFamily="Cascadia Code, Consolas" FontSize="11"
                                                  SelectionMode="Single" DoubleTapped="MacroActionList_DoubleTapped"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dedicated Action Card for Macro Replay -->
                    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="MacroDelayLabel" Text="Delay (s):" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <NumberBox x:Name="MacroDelayBox" Width="68" Value="3" Minimum="0" Maximum="60"
                                           FontSize="12" SpinButtonPlacementMode="Compact"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="MacroStatusText" Text="Ready" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="MacroProgressBar" Height="3" Value="0" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <Button x:Name="MacroActionBtn" Grid.Column="2" Width="136" Height="34" Click="MacroActionBtn_Click"
                                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:Name="MacroActionIcon" Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock x:Name="MacroActionText" Text="Replay Macro (F9)" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 5. Settings Panel                                          -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                        <TextBlock x:Name="SettingsTitleText" Text="偏好設定" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SettingsDescText" Text="自訂 Tapster 系統常駐、開機自動啟動與視窗行為" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Margin="0,0,8,0">
                            <!-- Card 0: Interface Language -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SettingsLangTitleText" Text="介面語言" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SettingsLangDescText" Text="選擇 Tapster 介面顯示語言，支援即時套用"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                              SelectionChanged="LanguageCombo_SelectionChanged"/>
                                </Grid>
                            </Border>

                            <!-- Card 1: Start on Boot -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SettingsBootTitleText" Text="開機自動啟動" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SettingsBootDescText" Text="於 Windows 登入時自動在背景啟動 Tapster 並常駐於系統匣"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartOnBootToggle" Grid.Column="1"
                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                  Toggled="StartOnBootToggle_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: Start Minimized to Tray -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SettingsStartMinTitleText" Text="啟動時最小化至系統匣" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SettingsStartMinDescText" Text="開啟應用程式時直接隱藏至右下角系統匣，不彈出主視窗干擾"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="1"
                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                  Toggled="StartMinimizedToggle_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Card 3: Minimize on Close -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SettingsCloseToTrayTitleText" Text="點擊關閉時縮小至系統匣" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SettingsCloseToTrayDescText" Text="點擊右上角關閉按鈕時縮排至系統匣，保持全域快捷鍵隨叫隨到"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MinimizeOnCloseToggle" Grid.Column="1"
                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                  Toggled="MinimizeOnCloseToggle_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Card 4: Always on Top -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SettingsTopTitleText" Text="視窗永遠置頂" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SettingsTopDescText" Text="將 Tapster 視窗固定於其他視窗最上層 (全域喚醒熱鍵 Ctrl+Alt+T)"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AlwaysOnTopToggle" Grid.Column="1"
                                                  OnContent="" OffContent="" VerticalAlignment="Center"
                                                  Toggled="AlwaysOnTopToggle_Toggled"/>
                                </Grid>
                            </Border>

                            <!-- Card 5: Global Hotkey Info -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="SettingsHkTitleText" Text="全域功能熱鍵" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="SettingsHkDescText" Text="即使在遊戲全螢幕或背景視窗，按下熱鍵亦可直接遙控所有功能"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <Grid RowSpacing="8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="HkWakeLabel" Grid.Row="0" Grid.Column="0" Text="喚醒 / 隱藏主視窗" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="Ctrl + Alt + T" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock x:Name="HkClickerLabel" Grid.Row="1" Grid.Column="0" Text="切換滑鼠連點 / 鍵盤連打" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="F6" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock x:Name="HkHolderLabel" Grid.Row="2" Grid.Column="0" Text="切換按鍵長按" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="F7" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock x:Name="HkTyperLabel" Grid.Row="3" Grid.Column="0" Text="啟動自動打字機" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Border Grid.Row="3" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="F8" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock x:Name="HkMacroLabel" Grid.Row="4" Grid.Column="0" Text="播放巨集" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Border Grid.Row="4" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="F9" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock x:Name="HkPanicKillLabel" Grid.Row="5" Grid.Column="0" Text="緊急全部終止" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Border Grid.Row="5" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="F10" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                        </Border>

                                        <TextBlock x:Name="HkPanicEscapeLabel" Grid.Row="6" Grid.Column="0" Text="緊急中斷跳出" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Border Grid.Row="6" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="Esc" FontFamily="Cascadia Code, Consolas" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 6: Navigation to About -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="SettingsAboutNavTitleText" Text="版本與專案資訊" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Tapster Fluent v1.2.0.0 (WinUI 3 + .NET NativeAOT Architecture)"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="SettingsAboutNavBtn" Grid.Column="1" Content="查看詳情" FontSize="11"
                                            Click="NavigateToAbout_Click" VerticalAlignment="Center"/>
                                 </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- 6. About Panel                                             -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="AboutPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                        <TextBlock x:Name="AboutTitleText" Text="關於 Tapster" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AboutDescText" Text="應用程式版本、技術規格、專案連結與隱私聲明" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="0,0,8,0">
                            <!-- Hero Card -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="Assets/StoreLogo.png" Width="64" Height="64"
                                           Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="Tapster Fluent" FontSize="20" FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="8,2">
                                                <TextBlock Text="v1.2.0.0 Release" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="AboutHeroSubText" Text="Windows 11 原生超輕量自動化助手"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="AboutHeroSub2Text" Text="專為遠端桌面 (VNC/RDP)、虛擬機、遊戲掛機與高頻點擊量身打造"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tech Specs Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="AboutSpecsTitleText" Text="技術規格" FontWeight="SemiBold" FontSize="13"/>
                                    <Grid RowSpacing="8" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="AboutSpecsUiLabel" Grid.Row="0" Grid.Column="0" Text="UI 框架" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="WinUI 3 (Windows App SDK 2.3.1) Mica &amp; Acrylic" FontSize="11" TextWrapping="Wrap"/>

                                        <TextBlock x:Name="AboutSpecsCoreLabel" Grid.Row="1" Grid.Column="0" Text="底層自動化核心" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="AboutSpecsCoreValueText" Grid.Row="1" Grid.Column="1" Text="Win32 SendInput 核心 / 微秒級高精調度" FontSize="11" TextWrapping="Wrap"/>

                                        <TextBlock x:Name="AboutSpecsPublishLabel" Grid.Row="2" Grid.Column="0" Text="發布架構" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="AboutSpecsPublishValueText" Grid.Row="2" Grid.Column="1" Text="雙軌制：Microsoft Store MSIX 封裝 + Standalone 綠色純單檔 EXE" FontSize="11" TextWrapping="Wrap"/>

                                        <TextBlock x:Name="AboutSpecsLicenseLabel" Grid.Row="3" Grid.Column="0" Text="授權條款" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="AboutSpecsLicenseValueText" Grid.Row="3" Grid.Column="1" Text="MIT License (100% 免費且開源)" FontSize="11" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Privacy and Open Folder Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutPrivacyTitleText" Text="隱私承諾與本地設定" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="AboutPrivacyDescText" Text="100% 離線純本機運行，零網路遙測傳輸，不收集任何按鍵或個人資料"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button x:Name="AboutOpenFolderBtn" Grid.Column="1" Content="開啟設定目錄" FontSize="11"
                                            Click="OpenSettingsFolder_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
